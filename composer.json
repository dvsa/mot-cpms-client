{
    "name": "dvsa/mot-cpms-client",
    "description": "CPMS Common Client Module",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "dvsa/mot-cpms-notifications": "^3.0.1",
        "laminas/laminas-mvc": "^3.3.0",
        "laminas/laminas-cache": "^3.12.0",
        "laminas/laminas-filter": "^2.13",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.0",
        "laminas/laminas-cache-storage-adapter-memory": "^2.0",
        "laminas/laminas-cache-storage-adapter-apcu": "^2.5.0",
        "dvsa/mot-logger": "dev-feature-bl-22896-add-multi-logger-support"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "laminas/laminas-component-installer": "^3.4.0",
        "laminas/laminas-test": "^4.0.0",
        "captainhook/captainhook": "^5.16",
        "captainhook/plugin-composer": "^5.3",
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.7",
        "dvsa/coding-standards": "^2.0",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-0": {
            "CpmsClient\\": "src/",
            "CpmsClientTest\\": "test/"
        },
        "classmap": [
            "./Module.php",
            "./test/CpmsClientTest/Module.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts" : {
        "phpcs": "./vendor/bin/phpcs .",
        "phpcs:fix": "./vendor/bin/phpcbf .",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "psalm": "COMPOSER_HOME=/dev/null COMPOSER_CACHE_DIR=/tmp/composer-cache ./vendor/bin/psalm --no-cache",
        "test": "vendor/bin/phpunit -c phpunit.xml"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "captainhook/plugin-composer": true,
            "laminas/laminas-dependency-plugin": true
        }
    }
}
